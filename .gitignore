# pixi environments
.pixi/*
!.pixi/config.toml

# excluded from this repo (tracked elsewhere)
input_log/
runlog_tools/

# local Claude Code settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.py[cod]

# local GENIE config (machine-specific paths + snapshotted spack envs)
genie-agent/config/

# generated run artefacts (splines, events, job logs)
genie-agent/genie-runs/

# jobsub-agent: machine-specific jobsub config + CVMFS publish catalog
jobsub-agent/config/

# jobsub-agent: per-job grid records + submit/fetched logs
jobsub-agent/jobsub-runs/

# jobsub-agent: built tarballs (large build artefacts)
jobsub-agent/tarballs/

# scratch / throwaway
test-hello/

# prd-analyzer XRootD-streamed selection cache (regenerable via build_cache*.py; any version)
results/prd-analyzer*/cache/
results/**/__pycache__/

# third-party MINERvA flux/reweight + param data (~3 GB external checkout, not ours)
minerva/

# fetched cross-section splines (regenerable: pulled from /pnfs or re-run gmkspl)
genie-agent/splines/

# dutta-qe analysis project: generated caches + outputs (regenerable)
analysis/dutta-qe/cache/
analysis/dutta-qe/out/
analysis/dutta-qe/__pycache__/

# external SIMC checkout (has its own .git; reference only, not ours)
simc_gfortran/

# bulk ROOT event/histogram inputs (123 MB files exceed GitHub's 100 MB limit)
data/luren/

# compiled ELF of dump_qel_1p.cxx (source is tracked)
results/template/dump_qel_1p
