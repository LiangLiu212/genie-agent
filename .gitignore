# pixi environments
.pixi/*
!.pixi/config.toml

# excluded from this repo (tracked elsewhere)
input_log/
runlog_tools/

# local Claude Code settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.py[cod]

# local GENIE config (machine-specific paths + snapshotted spack envs)
genie-agent/config/

# generated run artefacts (splines, events, job logs)
genie-agent/genie-runs/

# jobsub-agent: machine-specific jobsub config + CVMFS publish catalog
jobsub-agent/config/

# jobsub-agent: per-job grid records + submit/fetched logs
jobsub-agent/jobsub-runs/

# jobsub-agent: built tarballs (large build artefacts)
jobsub-agent/tarballs/
